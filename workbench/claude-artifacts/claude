#!/usr/bin/env python3
"""Start interactive Claude with approvals in the Workbench artifact profile."""
import os
import sys
from pathlib import Path

arguments = sys.argv[1:]
for index, argument in enumerate(arguments):
    if (argument == "--dangerously-skip-permissions"
            or argument == "--permission-mode=bypassPermissions"
            or arguments[index:index + 2] == ["--permission-mode", "bypassPermissions"]):
        sys.exit("This artifact profile requires Claude permission prompts.")
# Happier adds this flag even to ordinary sessions so the user can switch to bypass later.
# In a fresh interactive Claude profile it triggers a bypass consent screen before chat opens.
arguments = [arg for arg in arguments if arg != "--allow-dangerously-skip-permissions"]
binary = Path.home() / ".local/bin/claude"
os.execv(binary, [str(binary), *arguments])
